# Copy to backend/backend/.env and adjust. Never commit the real .env file.

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Defaults match the Postgres container in docker-compose.yml (`make db`).
# Port 5433 avoids clashing with a PostgreSQL already running on 5432.
POSTGRES_DB=djnext
POSTGRES_USER=djnext
POSTGRES_PASSWORD=djnext
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Optional: tuning for the wait_for_db command (defaults: 30 retries, 2s delay)
# DB_WAIT_RETRIES=30
# DB_WAIT_DELAY=2

# Where the frontend is served from. Used for links in verification and
# password-reset emails and as the default CSRF trusted origin.
# FRONTEND_URL=http://localhost:3000
# Name shown in the emails the app sends.
# SITE_NAME=dj-next
# Extra origins allowed by Django's CSRF check (comma-separated).
# CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Number of reverse proxies in front of Django (the Next.js server counts as
# one). allauth's rate limits then use the real client IP from X-Forwarded-For.
# TRUSTED_PROXY_COUNT=0
# Development only (ignored unless DEBUG=True): turn allauth's rate limits off.
# DISABLE_RATE_LIMITS=False

# Production hardening. With DEBUG=False these default to on (HSTS: 1 hour).
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600
# Set when a TLS-terminating reverse proxy sits in front of Django.
# USE_X_FORWARDED_PROTO=True
# Serve the admin from a less guessable path.
# ADMIN_URL=admin/

# Email. The defaults send to Mailpit (inbox at http://localhost:8025, started
# by `make db`). Point these at a real SMTP provider in production.
# EMAIL_HOST=127.0.0.1
# EMAIL_PORT=1025
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=False
# DEFAULT_FROM_EMAIL=dj-next <noreply@localhost>
# MAILPIT_SMTP_PORT=1025
# MAILPIT_UI_PORT=8025

# Google sign-in: create an OAuth client in Google Cloud Console (Web application)
# with redirect URI http://localhost:3000/accounts/google/login/callback/
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Shared secret between the Next.js server and Django. Must match
# PROXY_SHARED_SECRET in frontend/.env.local. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# PROXY_SHARED_SECRET=
