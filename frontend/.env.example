# Optional: copy to .env.local to override the defaults. Never commit .env.local.

# Base URL of the Django API. Read only on the server (proxy routes and the
# rewrite in next.config.ts); the rewrite is resolved at build time.
# BACKEND_URL=http://localhost:8000

# Must match PROXY_SHARED_SECRET in backend/backend/.env. Lets the Django API trust
# the public host that this server reports (needed for Google sign-in callbacks).
# PROXY_SHARED_SECRET=
